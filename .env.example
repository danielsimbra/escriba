# ---------------------------------------------------------------------------
# Escriba — copie este arquivo para .env e preencha. O .env NUNCA vai para o Git.
# ---------------------------------------------------------------------------

# --- Transcrição (OpenAI) --------------------------------------------------
# Chave em https://platform.openai.com/api-keys
# É esta API que converte o áudio em texto bruto; a Claude não recebe áudio.
OPENAI_API_KEY=sk-proj-...
# gpt-4o-transcribe é o padrão. whisper-1 é mais barato e um pouco pior em PT-BR.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Idioma do áudio em ISO-639-1. Informar acelera e melhora o resultado.
# Deixe vazio se você recebe áudio em vários idiomas.
TRANSCRIBE_LANGUAGE=pt

# --- Limpeza (Anthropic) ---------------------------------------------------
# Chave em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=8000

# --- WhatsApp (Evolution API) ---------------------------------------------
# Dentro do docker-compose o host é o nome do serviço.
# Rodando fora do Docker, troque por http://localhost:8080
EVOLUTION_BASE_URL=http://evolution-api:8080
# Precisa ser IDÊNTICO (maiúsculas incluídas) ao "instanceName" usado na
# criação da instância — a Evolution API diferencia caixa, e um nome
# divergente aqui causa 404 em /instance/connectionState/<nome>.
EVOLUTION_INSTANCE=Escriba
# Deve ser IDÊNTICA à AUTHENTICATION_API_KEY do serviço evolution-api.
EVOLUTION_API_KEY=troque-esta-chave-por-uma-aleatoria
# URL pública do gateway, usada pelo painel da Evolution.
# Na VPS, troque por http://SEU_IP:8080
EVOLUTION_SERVER_URL=http://localhost:8080
# Senha do Postgres que guarda a sessão do WhatsApp. Gere com: openssl rand -hex 16
POSTGRES_PASSWORD=troque-esta-senha

# --- Webhook (a Evolution chama o Escriba aqui) ----------------------------
# Endereço que a Evolution usa para entregar os eventos. Dentro do compose,
# é o nome do serviço. Fora do Docker, http://SEU_IP:8000/webhook
# Usado pelo comando: python -m escriba configurar-webhook
WEBHOOK_URL=http://escriba:8000/webhook
# Segredo compartilhado. O Escriba recusa (401) requisição sem ele, o que
# impede que qualquer um na rede injete evento falso. Gere com:
#   openssl rand -hex 24
# Vai como query string na URL registrada (?token=...) — o Escriba também
# aceita no header x-escriba-token. Deixe vazio para desligar a checagem
# (só faça isso se o Escriba não estiver exposto fora do Docker).
WEBHOOK_TOKEN=troque-este-token-por-um-aleatorio

# --- Servidor --------------------------------------------------------------
ESCRIBA_HOST=0.0.0.0
ESCRIBA_PORT=8000
# Quantos áudios podem ser transcritos ao mesmo tempo. Cada um segura uma
# chamada de API; acima disso o áudio espera a vez.
MAX_TRANSCRICOES_SIMULTANEAS=3

# --- Arquivos e diagnóstico ------------------------------------------------
TZ=America/Sao_Paulo
DB_PATH=/app/data/escriba.db
# REGRAS_PATH nao e definido de proposito: sem ele o Escriba usa
# config/escriba.local.yaml (a sua, com telefones reais, fora do Git) e so cai
# no template config/escriba.yaml se a local nao existir. Definir REGRAS_PATH
# aqui faz ele ignorar a local em silencio.
LOG_LEVEL=INFO
# true = transcreve e limpa normalmente, escreve tudo no log, mas NÃO manda
# nada no WhatsApp. Use para conferir a qualidade antes de soltar na conversa.
DRY_RUN=false
# true = guarda o áudio recebido em data/audios/ (útil para depurar uma
# transcrição ruim). Cuidado: é conteúdo privado de conversa em disco.
SALVAR_AUDIOS=false
